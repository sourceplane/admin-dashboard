# Local development only — the Worker never reads this file; its database is
# the HYPERDRIVE binding (wrangler.jsonc's localConnectionString locally).
#
# A Postgres connection string for drizzle-kit (`pnpm db:migrate`, which
# defaults to the Supabase CLI's database below) and for `next dev` without
# wrangler.
POSTGRES_URL=postgres://postgres:postgres@localhost:54322/postgres

# Optional. The session key: unset, the one the migrations generated in the
# database (app_private.secrets) is used.
# AUTH_SECRET=

# Optional. GitHub sign-in — https://authjs.dev/getting-started/providers/github
# (callback URL http://localhost:3000/api/auth/callback/github). Unset, the
# dashboard runs without sign-in and /login says how to connect it.
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
